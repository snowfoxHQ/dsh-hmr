{
  "name": "dsh-hmr-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "HMR cognitive memory runtime packaged for DeepSeek Harness (dsh)",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "vendor:python": "npm run vendor:python -w dsh-hmr",
    "preflight": "node scripts/preflight.mjs",
    "release:dry": "node scripts/publish.mjs --dry-run",
    "release": "node scripts/publish.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "^0.2.1-rc.2"
  }
}
